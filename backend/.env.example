# Large officer buys → Equity Research Agent full deep-dive pack
# After hourly US Form 4 sync, stage buys >= $500k from CEO/CFO/management,
# notify in-app (+ ntfy), wait ~60s for cancel, then POST to research agent.
DEEP_DIVE_BRIDGE_ENABLED=1
DEEP_DIVE_MIN_VALUE_USD=500000
DEEP_DIVE_CONFIRM_SECONDS=60
DEEP_DIVE_COOLDOWN_HOURS=72
DEEP_DIVE_BACKLOG_RETRY_MINUTES=60
DEEP_DIVE_TICK_SECONDS=10
DEEP_DIVE_RESEARCH_URL=http://127.0.0.1:8000
# DEEP_DIVE_RESEARCH_PIN=
DEEP_DIVE_RESEARCH_TEMPLATE=all
DEEP_DIVE_RESEARCH_MODE=deep
DEEP_DIVE_USE_OVERNIGHT_QUEUE=1
# prompt_now = Equity ntfy + auto-start in ~1 min (cancel → overnight)
# overnight = park only until Start overnight on Equity queue page/API
DEEP_DIVE_QUEUE_START_POLICY=prompt_now
DEEP_DIVE_SKIP_IF_RESEARCHED=1
DEEP_DIVE_NTFY_ENABLED=1
# Public/tunnel base for ntfy Cancel & Push action buttons (no browser).
# Defaults: DEEP_DIVE_PUBLIC_BASE_URL → data/tunnel_url.txt → http://127.0.0.1:5000
# DEEP_DIVE_PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
# DEEP_DIVE_OFFICER_TITLE_KEYWORDS=ceo,cfo,coo,cto,chief,president,managing director,general counsel,controller,treasurer

